<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>RazerLite</AssemblyName>
    <RootNamespace>RazerLite</RootNamespace>
    <Version>0.23.0</Version>
    <ApplicationIcon>razerlite.ico</ApplicationIcon>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- WinForms sadece tepsi ikonu icin kullanilir; WPF ile isim cakismasini onlemek icin ortuk using'leri kaldir. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="razerlite.ico" />
  </ItemGroup>
  <ItemGroup>
    <!-- Hz Testi araci exe'nin icine gomulur; tiklaninca %TEMP%\RazerLite'a cikarilip acilir (tek dosya dagitim). -->
    <EmbeddedResource Include="..\PollingRateTesterApp_v1.00.01.exe" Condition="Exists('..\PollingRateTesterApp_v1.00.01.exe')">
      <LogicalName>PollingRateTesterApp_v1.00.01.exe</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
